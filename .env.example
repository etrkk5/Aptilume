APP_MODE=development
APP_PORT=8080
DATA_DIR=./runtime
# CONTROL_STORE_URL=sqlite:////absolute/path/to/control.db
# Set a persistent Fernet key in container environments. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRET_ENCRYPTION_KEY=
# LLM and application DB connection details are managed in the admin UI.
OUTBOUND_ALLOWED_HOSTS=

# Development only. Production requires a unique password with at least 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=admin
PUBLIC_BASE_URL=http://127.0.0.1:8080
