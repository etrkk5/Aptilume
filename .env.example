# Local development only; use APP_MODE=demo for the four-role presentation.
# Docker image and unspecified APP_MODE default to production.
APP_MODE=development
APP_PORT=8080
DATA_DIR=./runtime
BOOTSTRAP_ADMIN_PASSWORD=admin
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Production requires HTTPS PUBLIC_BASE_URL, a unique 15-128 character bootstrap password
# and one persistent Fernet key, supplied by cluster Secret. Existing local admin passwords
# must be changed through the account form to satisfy the current policy before production.
# SECRET_ENCRYPTION_KEY=
# CONTROL_STORE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=verify-full&sslrootcert=/etc/certs/ca.pem
OUTBOUND_ALLOWED_HOSTS=
DB_ALLOWED_HOSTS=
DIRECTORY_ALLOWED_HOSTS=
OUTBOUND_ALLOWED_CIDRS=
LLM_CA_FILE=
FORWARDED_ALLOW_IPS=
EXPORT_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90
